{
  "name": "dsh-plugin-recent-folder",
  "version": "1.0.0",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "repository": { "type": "git", "url": "git+https://github.com/rapidrabbitsliu/dsh-plugin-recent-folder.git" },
  "homepage": "https://github.com/rapidrabbitsliu/dsh-plugin-recent-folder#readme",
  "bugs": { "url": "https://github.com/rapidrabbitsliu/dsh-plugin-recent-folder/issues" },
  "keywords": ["dsh", "deepseek-harness", "plugin", "workspace", "directory"],
  "type": "module",
  "description": "Remember the parent of the last selected workspace directory.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "scripts": { "test": "node --test tests/*.test.js", "check": "node --check index.js && node --check client.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
